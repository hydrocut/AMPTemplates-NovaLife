Meta.EndpointURIFormat=steam://connect/{ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=novalifeconfig.json
Meta.MetaConfigManifest=novalifemetaconfig.json
Meta.ConfigRoot=novalife.kvp
Meta.MinAMPVersion=2.5.0.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=29
Meta.ReleaseNotes=Panel v2.3 : comptes panel a roles (proprio-admin-modo), SMS-contacts-mails des joueurs (admin+), URL publique dans la banniere ; fix creation des dossiers icones sur instance neuve.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=9a624d70-5e24-4a2d-8a93-0d4fdc0e1f21
Meta.ImportableExtensions=[]

App.DisplayName=Nova-Life: Amboise
App.RootDir=./novalife/
App.BaseDirectory=./novalife/1665030/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=1665030/nova-life.x86_64
App.WorkingDir=1665030
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=-batchmode -nographics -startServer "{{ServerProfile}}" -logFile - {{CustomServerArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"SteamAppId":"885570","LD_LIBRARY_PATH":"{{$FullBaseDir}}linux64:%LD_LIBRARY_PATH%"}
App.CommandLineParameterFormat=-{0} {1}
App.CommandLineParameterDelimiter=
App.ExitMethod=OS_CLOSE
App.ExitTimeout=30
App.ExitString=quit
App.ExitFile=app_exit.lck
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.TailLogFilePath=
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0

App.Ports=@IncludeJson[novalifeports.json]

App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=ServerPort
App.UniversalSleepSteamQueryPortRef=SteamQueryPort
App.MaxUsers=32
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=ping
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}

App.UpdateSources=@IncludeJson[novalifeupdates.json]

App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.conf","*.config","*.ini","*.json","*.xml","*.properties","*.kvp","*.yml","*.yaml","*.toml","*.lua","*.db"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch

Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=(UnityMemory|memorysetup-|Shader |WARNING: Shader|ERROR: Shader|ALSA lib|FMOD|Invalid pass number|Trying to access pass|Couldn't create a Convex Mesh|Ran out of virtual channels|UnloadTime)
Console.AppReadyRegex=.*(\[LIFE SERVER\] Server launched in|Server successfully logged on to the Steam master server).*
Console.UserJoinRegex=^\[TKLOG\] JOIN pseudo="(?<username>.+?)" steamid=(?<userid>\d+)$
Console.UserLeaveRegex=^\[TKLOG\] LEAVE pseudo="(?<username>.+?)" steamid=(?<userid>\d+)$
Console.UserChatRegex=
Console.UpdateAvailableRegex=
Console.PreConnectRegex=.*Incoming connection:\s+::ffff:(?<ip>[0-9\.]+)\s+-\s+[0-9]+\s+connections\..*
Console.ConnectIPRegex=.*Incoming connection:\s+::ffff:(?<ip>[0-9\.]+)\s+-\s+[0-9]+\s+connections\..*
Console.MetricsRegex=^.*?-\s+(?<Connexions>\d+)\s+connections\.$
Console.HideFromConsoleRegex=(UnityMemory|memorysetup-|Shader |WARNING: Shader|ERROR: Shader|ALSA lib|FMOD|Invalid pass number|Trying to access pass|Couldn't create a Convex Mesh|Ran out of virtual channels|UnloadTime)
Console.SuppressLogAtStart=False
Console.UserActions={}

Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
